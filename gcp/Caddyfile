# Catch-all: works with ANY public IP (e2-micro ephemeral).
# Custom domain ready? Replace with:
#   fk-agent.example.com {
#       reverse_proxy n8n:5678
#   }
# (Caddy issues/renews HTTPS automatically.)
http:// {
	reverse_proxy n8n:5678
	encode gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
	}
}
