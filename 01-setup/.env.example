# Flipkart Agent OS — Environment Config
# Copy as: cp .env.example .env  |  Phir values bharo
# ⚠️ .env kabhi share/public mat karo

# ── LLM (kaunsa bhi ek) ─────────────────────────
OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-ant-your-key
LLM_MODEL=gpt-4o-mini            # cost-efficient default; gpt-4o quality ke liye

# ── Telegram (Assistant interface) ──────────────
TELEGRAM_BOT_TOKEN=123456789:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789       # aapka personal chat id
ALLOWED_CHAT_IDS=123456789       # comma-separated; sirf inhe bot use kar sakta hai

# ── WhatsApp (Phase 2, optional) ────────────────
# WATI_API_TOKEN=
# WATI_WEBHOOK_URL=
# WATI_PHONE_NUMBER_ID=

# ── Flipkart Seller API (per-seller keys alag file mein: data/api-keys.json) ──
FLIPKART_API_BASE=https://api.flipkart.net/api
FLIPKART_APP_KEY=
FLIPKART_APP_SECRET=

# ── System ──────────────────────────────────────
N8N_ENCRYPTION_KEY=change-me-long-random-string
DATA_DIR=/opt/agent-os/data
OUTPUT_DIR=/opt/agent-os/output
DAILY_DIGEST_TIME=07:00
TZ=Asia/Kolkata
# Finance
AVG_SYSTEM_COST_MONTHLY=5000     # ₹/month — net P&L mein deduct hoga
DEFAULT_RATE_PCT=4               # tentative rate jab tak seller se confirm na ho
